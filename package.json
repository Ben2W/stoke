{
  "name": "rigkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "release:check": "bun scripts/release/check.ts",
    "release:check-github-token": "bun scripts/release/check-github-token.ts",
    "release:preflight": "bun scripts/release/preflight.ts",
    "release:plan": "bun scripts/release/plan.ts",
    "release:bump": "bun scripts/release/bump.ts",
    "release:update-workflows": "bun scripts/release/update-workflow-options.ts",
    "release:prepare": "bun scripts/release/prepare.ts",
    "release:version": "bun scripts/release/version.ts",
    "release:pack": "bun scripts/release/pack.ts",
    "release:publish": "bun scripts/release/publish.ts",
    "release:trust-commands": "bun scripts/release/trust-commands.ts",
    "release:canary-version": "bun scripts/release/canary-version.ts",
    "release:sync-latest": "bun scripts/release/sync-latest-release.ts",
    "build:cli-binaries": "bun scripts/build-cli-binaries.ts",
    "rig": "pnpm --filter @rigkit/cli rig",
    "smoke:plan": "pnpm --filter @rigkit/cli rig -C ../../examples/smoke run plan",
    "smoke:apply": "pnpm --filter @rigkit/cli rig -C ../../examples/smoke run apply",
    "website:plan": "pnpm -C examples/freestyle-website-next rig:plan",
    "website:apply": "pnpm -C examples/freestyle-website-next rig:apply",
    "website:create": "pnpm -C examples/freestyle-website-next rig:create",
    "website:open": "pnpm -C examples/freestyle-website-next rig:open-cmux",
    "website:vscode": "pnpm -C examples/freestyle-website-next rig:open-vscode",
    "cmux:plan": "pnpm -C examples/cmux-playground rig:plan",
    "cmux:apply": "pnpm -C examples/cmux-playground rig:apply",
    "cmux:fork": "pnpm -C examples/cmux-playground rig:fork",
    "gcloud:plan": "pnpm -C examples/gcloud-on-open rig:plan",
    "gcloud:apply": "pnpm -C examples/gcloud-on-open rig:apply",
    "gcloud:fork": "pnpm -C examples/gcloud-on-open rig:fork",
    "gcloud:ssh": "pnpm -C examples/gcloud-on-open rig:ssh"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "turbo": "latest",
    "typescript": "latest"
  }
}

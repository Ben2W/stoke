{
  "name": "declarative-dev-servers",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "release:check": "bun scripts/check-release-versions.ts",
    "build:cli-binaries": "bun scripts/build-cli-binaries.ts",
    "fdev": "pnpm --filter @freestyle-sh/fdev-cli fdev",
    "smoke:plan": "pnpm --filter @freestyle-sh/fdev-cli fdev -C ../../examples/smoke plan",
    "smoke:apply": "pnpm --filter @freestyle-sh/fdev-cli fdev -C ../../examples/smoke apply"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}

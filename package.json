{
  "name": "rigkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "release:check": "bun scripts/check-release-versions.ts",
    "build:cli-binaries": "bun scripts/build-cli-binaries.ts",
    "rig": "pnpm --filter @rigkit/cli rig",
    "smoke:plan": "pnpm --filter @rigkit/cli rig -C ../../examples/smoke plan",
    "smoke:apply": "pnpm --filter @rigkit/cli rig -C ../../examples/smoke apply",
    "website:plan": "pnpm -C examples/freestyle-website-next rig:plan",
    "website:apply": "pnpm -C examples/freestyle-website-next rig:apply",
    "website:fork": "pnpm -C examples/freestyle-website-next rig:fork",
    "cmux:plan": "pnpm -C examples/cmux-playground rig:plan",
    "cmux:apply": "pnpm -C examples/cmux-playground rig:apply",
    "cmux:fork": "pnpm -C examples/cmux-playground rig:fork",
    "gcloud:plan": "pnpm -C examples/gcloud-on-open rig:plan",
    "gcloud:apply": "pnpm -C examples/gcloud-on-open rig:apply",
    "gcloud:fork": "pnpm -C examples/gcloud-on-open rig:fork",
    "gcloud:ssh": "pnpm -C examples/gcloud-on-open rig:ssh"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "turbo": "latest",
    "typescript": "latest"
  }
}

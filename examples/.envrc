# Prefer the workspace Rigkit CLI when running `rig` from examples/.
#
# direnv evaluates this file at examples/ and then keeps that environment for
# child directories, so a static `$PWD/node_modules/.bin` entry cannot follow
# `cd examples/<name>`. The shim in examples/bin resolves the current example at
# command time and delegates to that example's node_modules/.bin/rig.
examples_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PATH_add "$examples_dir/bin"

{
  "name": "@freestyle-sh/fdev-vscode",
  "version": "0.1.6",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freestyle-sh/fdev.git",
    "directory": "packages/fdev-vscode"
  },
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "workspaceContains:fdev.config.ts",
    "onView:fdevOperations",
    "onView:fdevWorkspaces",
    "onCommand:fdev.refresh",
    "onCommand:fdev.runOperation",
    "onCommand:fdev.openWorkspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fdev.refresh",
        "title": "fdev: Refresh"
      },
      {
        "command": "fdev.runOperation",
        "title": "fdev: Run Operation"
      },
      {
        "command": "fdev.openWorkspace",
        "title": "fdev: Run Workspace Action"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "fdevOperations",
          "name": "fdev Operations"
        },
        {
          "id": "fdevWorkspaces",
          "name": "fdev Workspaces"
        }
      ]
    }
  },
  "exports": {
    ".": "./dist/extension.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external vscode --outfile dist/extension.cjs",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@freestyle-sh/fdev-runtime-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rigkit-docs",
  "main": "./src/worker-app.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  // Default cache-busting namespace; `deploy:worker` overrides it per deploy
  // with `--var CACHE_VERSION:docs-<commit-sha>`.
  "vars": {
    "CACHE_VERSION": "docs-dev"
  },
  "assets": {
    "directory": "./dist/docs/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Public routing is owned by apps/website. The docs Worker is deployed as a
  // standalone service and reached through website service bindings.
  "routes": []
}

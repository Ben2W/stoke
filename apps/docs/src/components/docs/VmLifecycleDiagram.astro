---
// Hand-drawn, themed replacement for the previous Mermaid flowchart.
// Renders the VM lifecycle as a styled SVG state diagram with no client JS.
---

<figure class="vm-lifecycle" role="group" aria-label="Freestyle VM lifecycle diagram">
  <svg
    viewBox="0 0 660 400"
    role="img"
    aria-labelledby="vm-lifecycle-title vm-lifecycle-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="vm-lifecycle-title">Freestyle VM lifecycle</title>
    <desc id="vm-lifecycle-desc">
      A created VM becomes Running. Running can suspend to and resume from Suspended, stop to and
      start from Stopped, and fork into a new Running fork. Running, Suspended, and Stopped VMs can
      all be deleted.
    </desc>

    <defs>
      <marker
        id="vm-arrow-ink"
        class="vm-marker vm-marker--ink"
        viewBox="0 0 10 10"
        refX="8.5"
        refY="5"
        markerWidth="9"
        markerHeight="9"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z"></path>
      </marker>
      <marker
        id="vm-arrow-accent"
        class="vm-marker vm-marker--accent"
        viewBox="0 0 10 10"
        refX="8.5"
        refY="5"
        markerWidth="9"
        markerHeight="9"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z"></path>
      </marker>
      <marker
        id="vm-arrow-muted"
        class="vm-marker vm-marker--muted"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z"></path>
      </marker>
    </defs>

    <!-- Delete edges: any live state can be deleted. -->
    <g class="vm-edge vm-edge--delete">
      <path d="M325,338 H460" marker-end="url(#vm-arrow-muted)"></path>
      <path d="M312,230 L470,312" marker-end="url(#vm-arrow-muted)"></path>
      <path d="M318,88 L488,310" marker-end="url(#vm-arrow-muted)"></path>
    </g>

    <!-- Lifecycle edges -->
    <g class="vm-edge">
      <path d="M106,200 H170" marker-end="url(#vm-arrow-ink)"></path>
      <path d="M250,166 L250,89" marker-start="url(#vm-arrow-ink)" marker-end="url(#vm-arrow-ink)"
      ></path>
      <path d="M250,234 L250,311" marker-start="url(#vm-arrow-ink)" marker-end="url(#vm-arrow-ink)"
      ></path>
      <path class="vm-edge--fork" d="M306,170 L494,90" marker-end="url(#vm-arrow-accent)"></path>
    </g>

    <!-- Edge labels -->
    <g class="vm-edge-label">
      <text x="262" y="131">suspend / resume</text>
      <text x="262" y="277">stop / start</text>
      <text x="402" y="116" text-anchor="middle" class="vm-edge-label--accent">fork()</text>
      <text x="534" y="302" text-anchor="middle">delete()</text>
    </g>

    <!-- Nodes -->
    <g class="vm-node vm-node--terminal">
      <rect x="14" y="178" width="92" height="44" rx="22"></rect>
      <text x="60" y="200">create</text>
    </g>

    <g class="vm-node">
      <rect x="175" y="37" width="150" height="50" rx="10"></rect>
      <text x="250" y="62">Suspended</text>
    </g>

    <g class="vm-node vm-node--primary">
      <rect x="174" y="168" width="152" height="64" rx="12"></rect>
      <text x="250" y="200">Running</text>
    </g>

    <g class="vm-node">
      <rect x="175" y="313" width="150" height="50" rx="10"></rect>
      <text x="250" y="338">Stopped</text>
    </g>

    <g class="vm-node vm-node--fork">
      <rect x="459" y="37" width="150" height="50" rx="10"></rect>
      <text x="534" y="62">Running fork</text>
    </g>

    <g class="vm-node vm-node--terminal">
      <rect x="464" y="312" width="140" height="52" rx="10"></rect>
      <text x="534" y="338">Deleted</text>
    </g>
  </svg>
</figure>

<style>
  .vm-lifecycle {
    background: var(--panel-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin: 1.4rem 0;
    padding: 1.1rem 1.25rem;
  }

  .vm-lifecycle svg {
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 640px;
    width: 100%;
  }

  /* Nodes */
  .vm-node rect {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.4;
  }

  .vm-node text {
    dominant-baseline: middle;
    fill: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }

  .vm-node--primary rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.6;
  }

  .vm-node--primary text {
    fill: var(--accent);
    font-size: 16px;
    font-weight: 700;
  }

  .vm-node--fork rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-dasharray: 5 4;
    stroke-width: 1.4;
  }

  .vm-node--fork text {
    fill: var(--accent);
  }

  .vm-node--terminal rect {
    fill: var(--panel-soft);
    stroke: var(--line-strong);
  }

  .vm-node--terminal text {
    fill: var(--ink-soft);
    font-weight: 600;
  }

  /* Edges */
  .vm-edge path {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.7;
  }

  .vm-edge--fork {
    stroke: var(--accent) !important;
  }

  .vm-edge--delete path {
    stroke: var(--faint);
    stroke-dasharray: 4 4;
    stroke-width: 1.4;
  }

  .vm-marker--ink {
    fill: var(--ink-soft);
  }

  .vm-marker--accent {
    fill: var(--accent);
  }

  .vm-marker--muted {
    fill: var(--faint);
  }

  /* Edge labels */
  .vm-edge-label text {
    fill: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 550;
    paint-order: stroke;
    stroke: var(--panel-soft);
    stroke-linejoin: round;
    stroke-width: 3.5;
  }

  .vm-edge-label--accent {
    fill: var(--accent) !important;
    font-family: var(--mono) !important;
  }

  @media (max-width: 760px) {
    .vm-lifecycle {
      padding: 0.85rem;
    }
  }
</style>

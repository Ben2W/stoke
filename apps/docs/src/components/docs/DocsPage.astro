---
import { render, type CollectionEntry } from "astro:content";
import Card from "@/components/docs/Card.astro";
import CardGroup from "@/components/docs/CardGroup.astro";
import CodeGroup from "@/components/docs/CodeGroup.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import Note from "@/components/docs/Note.astro";
import OverviewCards from "@/components/docs/OverviewCards.astro";
import SearchIntent from "@/components/docs/SearchIntent.astro";
import Tip from "@/components/docs/Tip.astro";
import Update from "@/components/docs/Update.astro";
import VmLifecycleDiagram from "@/components/docs/VmLifecycleDiagram.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
}

const { entry, entries } = Astro.props;
const rendered = await render(entry);
const { Content, headings } = rendered;
const isCurrentOverview = entry.id === "index";
---

<DocsLayout entry={entry} entries={entries} headings={headings}>
  {
    isCurrentOverview && (
      <>
        <p>Rigkit runs development environments from a TypeScript config.</p>
        <p>
          You write the setup once, Rigkit prepares it, and then you create as many named
          workspaces as you need for agents, developers, CI jobs, or tests.
        </p>
        <OverviewCards />
        <SearchIntent auto />
      </>
    )
  }
  <Content
    components={{
      Card,
      CardGroup,
      CodeGroup,
      Note,
      OverviewCards,
      SearchIntent,
      Tip,
      Update,
      VmLifecycleDiagram,
    }}
  />
</DocsLayout>

---
import React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { ArrowTopRightOnSquareIcon } from "@heroicons/react/24/outline";

interface Props {
  href: string;
}

const { href } = Astro.props;

const icon = renderToStaticMarkup(
  React.createElement(ArrowTopRightOnSquareIcon, {
    width: 16,
    height: 16,
    "aria-hidden": true,
    focusable: false,
  }),
);
---

<a class="toc-rail-action" href={href} target="_blank" rel="noopener">
  <span class="toc-rail-action__icon" set:html={icon} />
  <span>Open Markdown</span>
</a>

---
import React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { DocumentDuplicateIcon, CheckIcon } from "@heroicons/react/24/outline";

interface Props {
  href: string;
}

const { href } = Astro.props;

const iconProps = {
  width: 16,
  height: 16,
  "aria-hidden": true,
  focusable: false,
};
const copyIcon = renderToStaticMarkup(React.createElement(DocumentDuplicateIcon, iconProps));
const checkIcon = renderToStaticMarkup(React.createElement(CheckIcon, iconProps));
---

<button type="button" class="toc-rail-action copy-page" data-md-href={href}>
  <span class="toc-rail-action__icon copy-page__icon" set:html={copyIcon} />
  <span class="toc-rail-action__icon copy-page__check" set:html={checkIcon} />
  <span class="copy-page__label">Copy Text Content</span>
</button>

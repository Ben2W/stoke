---
import type { ResolvedDocsFigure } from "@/lib/docs-figures";

interface Props {
  figure: ResolvedDocsFigure;
  alt?: string;
  class?: string;
}

const { figure, alt = "", class: className } = Astro.props;
---

<div
  class:list={["docs-nav-figure", className]}
  style={`--docs-figure-bg: ${figure.backgroundColor}`}
>
  <img src={figure.url} alt={alt} loading="lazy" decoding="async" />
</div>

---
import DocsPage from "@/components/docs/DocsPage.astro";
import { getDocsEntries } from "@/lib/docs";

export const prerender = true;

const entries = await getDocsEntries();
const entry = entries.find((item) => item.id === "index");

if (!entry) {
  throw new Error("Missing docs index page");
}
---

<DocsPage entry={entry} entries={entries} />

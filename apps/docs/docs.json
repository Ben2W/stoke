{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rigkit",
  "description": "Declarative dev environments, in TypeScript.",
  "banner": {
    "content": "🚧 Docs are under construction — pages are stubs while the rigkit v0.2 surface stabilizes. [Track progress on GitHub](https://github.com/freestyle-sh/rigkit) or [join the Discord](https://discord.com/invite/v5WT4fbXhc).",

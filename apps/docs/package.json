{
  "name": "@rigkit/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-worker.ts",
    "dev:astro": "astro dev",
    "dev:worker": "bun scripts/dev-worker.ts",
    "build": "rm -rf dist && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run scripts/just-bash.test.ts scripts/worker-cache.test.ts",
    "test:just-bash": "vitest run scripts/just-bash.test.ts",
    "test:worker": "vitest run scripts/worker-cache.test.ts",
    "broken-links": "astro check",
    "version": "bun ../../scripts/docs/version.ts",
    "check-version": "bun ../../scripts/docs/check-version.ts",
    "deploy:prepare": "rm -rf .wrangler/deploy && rm -f dist/docs/client/docs/wrangler.json",
    "deploy:worker": "bun run deploy:prepare && wrangler deploy --config wrangler.jsonc --var CACHE_VERSION:$(bun scripts/cache-version.ts)",
    "deploy:version": "bun ../../scripts/docs/deploy-worker.ts",
    "deploy:dry-run:package": "bun run deploy:prepare && wrangler deploy --config wrangler.jsonc --dry-run --outdir /tmp/rigkit-docs-worker-dry-run",
    "deploy:dry-run": "bun run build && bun run deploy:dry-run:package",
    "deploy": "bun run build && bun run deploy:worker",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^6.0.1",
    "@heroicons/react": "^2.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.4.2",
    "hono": "^4.12.23",
    "just-bash": "^3.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "satori": "^0.26.0",
    "simple-icons": "^16.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260525.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}

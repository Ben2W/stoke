---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Header from "@/components/Header.astro";
import { InstallBlock } from "@/components/InstallBlock";
import CodeShowcase from "@/components/CodeShowcase.astro";
import { CliShowcase } from "@/components/CliShowcase";
import DiscordIcon from "@/components/DiscordIcon.astro";
import { LatestVersionBadge } from "@/components/LatestVersionBadge";
---

<SiteLayout
  title="Rigkit — declarative dev environments, in TypeScript"
  description="Spin up forkable dev environments for your agents — VM, authenticated CLIs, editor, and preview URL — from a single typed config."
>
  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1 px-6 pt-10 pb-20 sm:px-10 sm:pt-16">
      <section class="mx-auto flex w-full max-w-4xl flex-col">
        <LatestVersionBadge client:load />

        <h1
          class="font-sans text-[44px] font-extrabold leading-[1.02] tracking-[-0.035em] text-[var(--color-fg)] sm:text-[56px]"
        >
          Declarative dev environments,
          <br />
          in TypeScript.
        </h1>

        <p
          class="mt-5 max-w-xl font-sans text-[16px] leading-[1.55] text-[#2a2a2a]"
        >
          Spin up forkable dev environments for your agents — VM, authenticated
          CLIs, editor, and preview URL — from a single typed config.
        </p>

        <div class="mt-10">
          <InstallBlock client:load />
        </div>

        <div
          class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 font-mono text-[13px]"
        >
          <a
            href="https://docs.rigkit.dev"
            class="inline-flex items-center gap-1.5 text-[var(--color-accent)] underline-offset-4 transition-all hover:underline"
          >
            Read the docs
            <span aria-hidden="true">→</span>
          </a>
          <span class="text-[var(--color-dim)]">·</span>
          <a
            href="https://discord.com/invite/v5WT4fbXhc"
            class="inline-flex items-center gap-1.5 text-[#5865f2] underline-offset-4 transition-all hover:underline"
          >
            <DiscordIcon class="h-[10px] w-[13px]" />
            Join the Discord
          </a>
          <span class="text-[var(--color-dim)]">·</span>
          <a
            href="https://github.com/freestyle-sh/rigkit"
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
          >
            github.com/freestyle-sh/rigkit
          </a>
        </div>
      </section>

      <section class="mx-auto mt-16 flex w-full max-w-4xl flex-col gap-6 sm:mt-20">
        <CliShowcase client:visible />
        <CodeShowcase />
      </section>
    </main>

    <footer
      class="border-t border-[var(--color-border)] px-6 py-5 font-mono text-[12px] text-[var(--color-dim)] sm:px-10"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span>
          Built by
          <a
            href="https://www.freestyle.sh"
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
            >Freestyle</a
          >
        </span>
        <span>
          <a
            href="/install"
            class="transition-colors hover:text-[var(--color-fg)]"
            >/install</a
          >
          ·
          <a
            href="/latest.json"
            class="transition-colors hover:text-[var(--color-fg)]"
            >/latest.json</a
          >
        </span>
      </div>
    </footer>
  </div>
</SiteLayout>

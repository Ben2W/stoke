---
import { codeToHtml } from "shiki";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Header from "@/components/Header.astro";
import { InstallBlock } from "@/components/InstallBlock";
import { SetupPrompt } from "@/components/SetupPrompt";
import { CliShowcase } from "@/components/CliShowcase";
import { ConfigShowcase } from "@/components/ConfigShowcase";
import type { ConfigSnippet } from "@/components/ConfigShowcase";
import { CmuxShowcase } from "@/components/CmuxShowcase";

const rigConfigSnippet = `import { freestyle, VmBaseImage, VmSpec } from "@rigkit/provider-freestyle";
import { workflow } from "@rigkit/sdk";

const repo = "vercel/next.js-starter";
const repoPath = "/workspace/app";
const devPort = 3000;

const vmSpec = new VmSpec()
  .idleTimeoutSeconds(3600);

const app = workflow("playground");
const freestyleProvider = freestyle.provider();

export default app
  .sequence("playground")
  .addProvider("freestyle", freestyleProvider)
  .task("clone-and-install", async ({ providers }) => {
    const { vm } = await providers.freestyle.client.vms.create({
      spec: vmSpec,
      logger: console.log,
    });
    await vm.exec(\`git clone https://github.com/\${repo}.git \${repoPath}\`);
    await vm.exec(\`cd \${repoPath} && bun install\`);
    const snapshot = await vm.snapshot();
    return { ctx: { snapshotId: snapshot.snapshotId } };
  })
  .workspace({
    create: async ({ workflow, providers }) => {
      const { vmId } = await providers.freestyle.client.vms.create({
        snapshotId: workflow.ctx.snapshotId,
      });
      return { vmId, repoPath, devPort };
    },
  })
  .workspaceOperation("open", {
    title: "Open",
    run: async ({ providers, workspace, local }) => {
      const vscode = await providers.freestyle.vscode.createUrl({
        vmId: workspace.ctx.vmId,
        cwd: workspace.ctx.repoPath,
      });
      const preview = await providers.freestyle.forwardPort({
        vmId: workspace.ctx.vmId,
        port: workspace.ctx.devPort,
      });
      await Promise.all([local.open(vscode), local.open(preview)]);
    },
  });
`;

const rigConfigHtml = await codeToHtml(rigConfigSnippet, {
  lang: "ts",
  theme: "github-light",
});

type RawSnippet = {
  id: string;
  label: string;
  blurb: string;
  code: string;
  interactive?: boolean;
  demo?: "auth" | "operation";
};

const rawSnippets: RawSnippet[] = [
  {
    id: "interactive-auth",
    label: "Interactive auth",
    interactive: true,
    demo: "auth",
    blurb:
      "Need a human in the loop? Open an interactive SSH terminal in the user's local environment. rig apply pauses until they finish — then snapshots the authenticated state so the next run is one-shot.",
    code: `.task("github-auth", async ({ step, providers }) => {
  const { vm, vmId } = await providers.freestyle.client.vms.create({
    snapshotId: step.ctx.snapshotId,
  });

  await providers.terminal.open("Log in to GitHub", {
    ssh: await providers.freestyle.createSSHOptions({ vmId }),
    command: "gh auth login --hostname github.com --web",
    keepOpenAfterCommand: true,
    instructions: "Complete the GitHub login in this terminal.",
  });

  const snapshot = await vm.snapshot();
  return { ctx: { snapshotId: snapshot.snapshotId } };
});
`,
  },
  {
    id: "cached-tasks",
    label: "Cached by version",
    blurb:
      "Every task is cached. Tag it with a version — and an optional TTL — and rig reuses the snapshot until something changes. Edit one task and only it and everything downstream re-runs.",
    code: `export const website = app
  .sequence("website")
  .addProvider("freestyle", freestyle.provider())
  // Bump the version string to force a rebuild.
  .task("apt-deps", { version: "node22-v2" }, installAptDeps)
  .task("js-tools", { version: "bun-codex-v3" }, installJsTools)
  .task("github-auth", { version: "auth-v6" }, githubAuth)
  // Re-validate at most once a day.
  .task("warm-codex", { version: "codex-v1", cacheTTL: "24h" }, warmCodex);
`,
  },
  {
    id: "typed-operations",
    label: "Typed operations",
    interactive: true,
    demo: "operation",
    blurb:
      "Operations are typed commands with a Zod input schema. Pass inputs as flags in CI — or omit them and rig prompts interactively: text fields to type, enums to pick from a list.",
    code: `import { z } from "@rigkit/sdk";

.workspaceOperation("task", {
  title: "Run an agent task",
  description: "Run an agent, push the branch, open a PR",
  input: z.object({
    task: z.string().min(1).describe("What should the agent do?"),
    agent: z.enum(["codex", "claude"]).default("claude"),
  }),
  run: async ({ workspace, input }) => {
    const prUrl = await runAgentAndOpenPr(workspace, input);
    return { prUrl };
  },
});
`,
  },
  {
    id: "compose",
    label: "Compose & reuse",
    blurb:
      "Tasks, sequences, and parallel branches are plain values. Store them in variables, fork independent branches off the same context, and share one cached base across projects.",
    code: `// A node is just a value — name it, then reuse it.
const base = app
  .sequence("base")
  .task("install-tooling", installTooling)
  .task("github-auth", githubAuth);

// Parallel branches fork from the same upstream context.
const services = app
  .parallel("services")
  .add(provisionDatabase)
  .add(seedFixtures);

export const website = app.sequence("website").add(base).add(services);
`,
  },
];

const configSnippets: ConfigSnippet[] = await Promise.all(
  rawSnippets.map(async (snippet) => ({
    id: snippet.id,
    label: snippet.label,
    blurb: snippet.blurb,
    interactive: snippet.interactive,
    demo: snippet.demo,
    html: await codeToHtml(snippet.code, {
      lang: "ts",
      theme: "github-light",
    }),
  })),
);
---

<SiteLayout
  title="Rigkit — developer environments as code"
  description="Define your whole dev environment in TypeScript — VM, tools, even an interactive GitHub login. Snapshot it once, then fork it into ten agents that all boot up already authenticated."
>
  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1 px-6 pt-10 pb-20 sm:px-10 sm:pt-16">
      <section class="mx-auto flex w-full max-w-4xl flex-col">
        <h1
          class="font-sans text-[44px] font-extrabold leading-[1.02] tracking-[-0.035em] text-[var(--color-fg)] sm:text-[56px]"
        >
          Developer environments
          <br />
          as code.
        </h1>

        <p
          class="mt-5 max-w-xl font-sans text-[16px] leading-[1.55] text-[#2a2a2a]"
        >
          Define your whole dev environment in TypeScript, the packages, repos, and clis you need to authenticate into. Then fork 10 of them!
        </p>

        <div class="mt-10">
          <p class="mb-2 ml-1 text-xs tracking-[0.1em] text-[var(--color-dim)]">
            First, install the Rigkit CLI:
          </p>
          <InstallBlock client:load />
        </div>

        <div class="mt-7">
          <p
            class="mb-2 ml-1 text-xs tracking-[0.1em] text-[var(--color-dim)]"
          >
            Then give the following to the coding agent of your choice:
          </p>
          <SetupPrompt client:load />
        </div>
      </section>

      <section class="mx-auto mt-16 flex w-full max-w-4xl flex-col gap-6 sm:mt-20">
        <CliShowcase client:visible configHtml={rigConfigHtml} />
      </section>

      <section
        class="mx-auto mt-24 flex w-full max-w-4xl flex-col gap-6 sm:mt-32"
      >
        <header class="flex flex-col gap-3">
          <h2
            class="font-sans text-[32px] font-extrabold leading-[1.05] tracking-[-0.03em] text-[var(--color-fg)] sm:text-[40px]"
          >
            Define what your agents' workspaces look like
          </h2>
            <p
              class="max-w-xl font-sans text-[15px] leading-[1.55] text-[#2a2a2a]"
            >
              Want to spin up 10 workspaces based off your development environment and open them all in cmux? You can define that.
            </p>
            <p
              class="max-w-xl font-sans text-[15px] leading-[1.55] text-[#2a2a2a]"
            >
              Want to open one of them in VS Code, you can define that too.
            </p>
        </header>
        <CmuxShowcase client:visible />
      </section>

      <section class="mt-24 border-y border-[var(--color-border)] bg-[#f7f4ec] py-20 sm:mt-32 sm:py-24">
        <div class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 sm:px-10">
          <header class="flex flex-col gap-3">
            <h2
              class="font-sans text-[32px] font-extrabold leading-[1.05] tracking-[-0.03em] text-[var(--color-fg)] sm:text-[40px]"
            >
              Your config is just TypeScript.
            </h2>
            <p
              class="max-w-2xl font-sans text-[15px] leading-[1.55] text-[#2a2a2a]"
            >
              Tasks, workspaces, and operations are typed functions. Cache them
              by version, give operations Zod-typed inputs, and compose the whole
              graph the way you'd write any other module.
            </p>
          </header>
          <ConfigShowcase client:visible snippets={configSnippets} />
        </div>
      </section>

      <section
        class="mx-auto mt-24 flex w-full max-w-4xl flex-col items-center gap-8 px-6 sm:mt-32 sm:px-10"
      >
        <p
          class="max-w-xl text-center font-sans text-[15px] leading-[1.55] text-[#2a2a2a]"
        >
          The full API reference, provider catalog, and a handful of worked
          examples — including the website and cmux configs powering this page.
        </p>
        <a
          href="/docs"
          class="group relative flex w-full max-w-2xl items-center justify-between gap-6 overflow-hidden rounded-2xl bg-[var(--color-accent)] py-6 pr-6 pl-7 text-left transition-transform hover:-translate-y-[1px] sm:py-8 sm:pr-8 sm:pl-12"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-3 left-3 hidden w-px bg-white/15 sm:block"
          ></span>
          <div class="flex flex-col gap-1.5">
            <span
              class="inline-flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/70"
            >
              <span aria-hidden="true">$</span>
              www.rigkit.dev/docs
            </span>
            <span
              class="font-sans text-[28px] font-extrabold leading-[1.02] tracking-[-0.03em] text-white sm:text-[44px]"
            >
              Read the docs.
            </span>
            <span
              class="mt-0.5 font-sans text-[12.5px] leading-[1.45] text-white/75 sm:text-[13.5px]"
            >
              API reference · providers · examples
            </span>
          </div>
          <span
            class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white text-[var(--color-accent)] transition-transform group-hover:translate-x-1 sm:h-16 sm:w-16"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 sm:h-6 sm:w-6"
            >
              <path d="M5 12h14"></path>
              <path d="M13 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </section>
    </main>

    <footer
      class="border-t border-[var(--color-border)] px-6 py-5 font-mono text-[12px] text-[var(--color-dim)] sm:px-10"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span>
          Built by
          <a
            href="https://www.freestyle.sh"
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
            >Freestyle</a
          >
        </span>
        <span>
          <a
            href="/install"
            class="transition-colors hover:text-[var(--color-fg)]"
            >/install</a
          >
          ·
          <a
            href="/latest.json"
            class="transition-colors hover:text-[var(--color-fg)]"
            >/latest.json</a
          >
        </span>
      </div>
    </footer>
  </div>
</SiteLayout>

<style is:global>
  .config-pane pre.shiki,
  .config-pane pre.shiki > code {
    background: transparent !important;
    font-family: var(--font-mono) !important;
    font-size: 12.5px;
    line-height: 1.6;
  }
  .config-pane pre.shiki {
    margin: 0;
    padding: 0;
    white-space: pre;
  }
</style>

---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Header from "@/components/Header.astro";
import { ReleaseDetail } from "@/components/ReleaseDetail";
---

<SiteLayout
  title="Rigkit release"
  description="Install instructions and notes for a specific Rigkit release."
>
  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1 px-6 pt-10 pb-20 sm:px-10 sm:pt-16">
      <section class="mx-auto flex w-full max-w-3xl flex-col">
        <ReleaseDetail client:load />
      </section>
    </main>
  </div>
</SiteLayout>

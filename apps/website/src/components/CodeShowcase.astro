---
import { Code } from "astro:components";

const snippet = `import { freestyle, VmBaseImage, VmSpec } from "@rigkit/provider-freestyle";
import { workflow } from "@rigkit/sdk";

const repo = "vercel/next.js-starter";
const repoPath = "/workspace/app";
const devPort = 3000;

const vmSpec = new VmSpec()
  .idleTimeoutSeconds(3600);

const app = workflow("playground", {
  providers: { freestyle: freestyle.provider() },
});

export default app
  .sequence("playground")
  .task("clone-and-install", async ({ freestyle }) => {
    const { vm } = await freestyle.client.vms.create({
      spec: vmSpec,
      logger: console.log,
    });
    await vm.exec(\`git clone https://github.com/\${repo}.git \${repoPath}\`);
    await vm.exec(\`cd \${repoPath} && bun install\`);
    const snapshot = await vm.snapshot();
    return { ctx: { snapshotId: snapshot.snapshotId } };
  })
  .workspace({
    create: async ({ workflow, providers }) => {
      const { vmId } = await providers.freestyle.client.vms.create({
        snapshotId: workflow.ctx.snapshotId,
      });
      return { vmId, repoPath, devPort };
    },
  })
  .workspaceOperation("open", {
    title: "Open",
    run: async ({ providers, workspace, local }) => {
      const vscode = await providers.freestyle.vscode.createUrl({
        vmId: workspace.ctx.vmId,
        cwd: workspace.ctx.repoPath,
      });
      const preview = await providers.freestyle.forwardPort({
        vmId: workspace.ctx.vmId,
        port: workspace.ctx.devPort,
      });
      await Promise.all([local.open(vscode), local.open(preview)]);
    },
  });
`;
---

<section class="w-full">
  <div
    class="overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_1px_0_rgba(10,10,10,0.04)]"
  >
    <div
      class="flex items-center border-b border-[var(--color-border)] bg-[#f2efe7] px-4 py-2.5"
    >
      <span class="font-mono text-[12px] text-[var(--color-muted)]">
        rig.config.ts
      </span>
    </div>
    <div class="code-host overflow-x-auto px-4 py-4">
      <Code code={snippet} lang="ts" theme="github-light" />
    </div>
  </div>
</section>

<style is:global>
  .code-host pre.astro-code,
  .code-host pre.astro-code > code {
    background: transparent !important;
    font-family: var(--font-mono) !important;
    font-size: 13px;
    line-height: 1.55;
  }
  .code-host pre.astro-code {
    margin: 0;
    padding: 0;
  }
</style>

---
import DiscordIcon from "@/components/DiscordIcon.astro";
import { StarButton } from "@/components/StarButton";
import { VersionTag } from "@/components/VersionTag";
---

<header class="flex items-center justify-between px-6 py-5 sm:px-10">
  <div class="flex items-baseline gap-2">
    <a href="/" class="inline-flex items-center text-[var(--color-fg)]">
      <span class="font-mono text-[15px] font-medium tracking-[-0.01em]"
        >rigkit</span
      >
    </a>
    <VersionTag client:load />
  </div>
  <nav class="flex items-center gap-3 font-mono text-[13px] text-[var(--color-muted)]">
    <a
      href="/docs"
      class="hidden transition-colors hover:text-[var(--color-fg)] sm:inline"
    >
      Docs
    </a>
    <a
      href="/releases"
      class="hidden transition-colors hover:text-[var(--color-fg)] sm:inline"
    >
      Releases
    </a>
    <StarButton client:load />
    <a
      href="https://discord.com/invite/v5WT4fbXhc"
      class="inline-flex items-center gap-1.5 rounded-md bg-[#5865f2] px-2.5 py-1.5 text-white transition-opacity hover:opacity-90"
    >
      <DiscordIcon class="h-[12px] w-[15.5px]" />
      <span>Discord</span>
    </a>
  </nav>
</header>

---
import { BrandMark } from "@/components/BrandMark";
import DiscordIcon from "@/components/DiscordIcon.astro";
---

<header class="flex items-center justify-between px-6 py-5 sm:px-10">
  <a href="/" class="inline-flex items-center gap-2.5 text-[var(--color-fg)]">
    <BrandMark className="h-[22px] w-[22px]" />
    <span class="font-mono text-[15px] font-medium tracking-[-0.01em]">rigkit</span>
  </a>
  <nav class="flex items-center gap-5 font-mono text-[13px] text-[var(--color-muted)]">
    <a
      href="https://docs.rigkit.freestyle.sh"
      class="hidden transition-colors hover:text-[var(--color-fg)] sm:inline"
    >
      Docs
    </a>
    <a
      href="https://github.com/freestyle-sh/rigkit"
      class="hidden transition-colors hover:text-[var(--color-fg)] sm:inline"
    >
      GitHub
    </a>
    <a
      href="https://discord.com/invite/v5WT4fbXhc"
      class="inline-flex items-center gap-1.5 rounded-md bg-[#5865f2] px-2.5 py-1.5 text-white transition-opacity hover:opacity-90"
    >
      <DiscordIcon class="h-[12px] w-[15.5px]" />
      <span>Discord</span>
    </a>
  </nav>
</header>
